# Cloudflare Pages Custom Caching Headers

# Hashed build assets from Vite - Cache forever (1 year immutable)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static illustrations, audio, and mascots - 7 days browser cache + 1 day stale-while-revalidate
/illos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/sounds/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/capi/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML entry point - Never cache stale HTML so new releases are instant
/index.html
  Cache-Control: public, max-age=0, must-revalidate
